{
  "name": "passo-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drives your own logged-in Chrome to grab a Passo match ticket the moment a sale opens, then hands over to you for payment.",
  "scripts": {
    "start": "node src/bot.js",
    "preflight": "node src/bot.js --preflight",
